# Cloudflare Pages / Netlify headers.
#
# Rules are merged in order, so the broad ones come first and the specific ones below
# override them. netlify.toml carries the same policy for Netlify deploys; this file is
# what Cloudflare Pages reads.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# App code has no content hashing, so revalidate each time (cheap 304s via ETag).
/src/*
  Cache-Control: public, max-age=0, must-revalidate

/styles/*
  Cache-Control: public, max-age=0, must-revalidate

# The resume may be replaced between deploys, so keep this short.
/assets/*
  Cache-Control: public, max-age=3600

/assets/icons/*
  Cache-Control: public, max-age=604800

# Version-pinned dependency: safe to cache forever.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
